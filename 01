const cardDatabase = rawData.split(/\r?\n/).filter(Boolean).map((line,index)=>{
  const [app,gen,name,attr,spec,passive]=line.split("|").map(v=>v.trim());
  let condType="無";
  const match=passive.match(/^(.+?)\s*\*\s*2\s*➔/);
  if(match) condType=match[1].trim();
  let skill="其他";
  if(passive.includes("無提供技能資料")) skill="無";
  else if(passive.includes("+分數")) skill="分數支援";
  else if(passive.includes("+表現力")) skill="表現力UP";
  else if(passive.includes("+技巧")) skill="技巧UP";
  else if(passive.includes("+品味")) skill="品味UP";
  else if(passive.includes("全能力")) skill="能力UP";
  return {id:index,app,gen,name,attr,spec,passive,condType,skill};
});
const filters={gen:null,attr:null,spec:null,skill:null,app:null};
let activeCoreCard=null;
const grid=document.getElementById("cardGrid");
const title=document.getElementById("panel-title");
const count=document.getElementById("count");
const empty=document.getElementById("empty-state");
const searchBox=document.getElementById("searchBox");
function makeCard(card){
  const el=document.createElement("article");
  el.className="card";el.dataset.id=card.id;el.tabIndex=0;el.setAttribute("role","button");
  const name=document.createElement("div");name.className="name";name.textContent=`${card.name}（${card.app==="泳裝"?"👙 泳裝":"📊 普通"}）`;
  const tags=document.createElement("div");tags.className="tag-container";
  [[card.gen,"rgba(0,162,255,.15)"],[card.attr,"rgba(255,77,77,.15)"],[card.spec,"rgba(46,213,115,.15)"]].forEach(([txt,bg])=>{const t=document.createElement("span");t.className="tag";t.style.background=bg;t.textContent=txt;tags.appendChild(t);});
  const skill=document.createElement("div");skill.className="skill-info";skill.textContent="🧬 "+card.passive;
  el.append(name,tags,skill);
  const select=()=>{if(activeCoreCard&&activeCoreCard.id===card.id)activeCoreCard=null;else activeCoreCard=card;render();};
  el.addEventListener("click",select);el.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();select();}});
  return el;
}
const cardElements=new Map();
cardDatabase.forEach(card=>{const el=makeCard(card);cardElements.set(card.id,el);grid.appendChild(el);});
function render(){
  const query=searchBox.value.trim().toLocaleLowerCase();
  const hasFilter=Object.values(filters).some(Boolean)||query.length>0;
  let visible=0;
  cardDatabase.forEach(card=>{
    const el=cardElements.get(card.id);
    const searchText=[card.name,card.gen,card.attr,card.spec,card.passive,card.app].join(" ").toLocaleLowerCase();
    const searchMatch=!query||searchText.includes(query);
    const filterMatch=(!filters.gen||card.gen===filters.gen)&&(!filters.attr||card.attr===filters.attr)&&(!filters.spec||card.spec===filters.spec)&&(!filters.skill||card.skill===filters.skill)&&(!filters.app||card.app===filters.app)&&searchMatch;
    el.classList.remove("match-filter","synergy-partner","selected-core","dimmed");
    let show=true;
    if(activeCoreCard){
      const isSelf=card.id===activeCoreCard.id;
      if(isSelf)el.classList.add("selected-core");
      else if(isSynergy(activeCoreCard,card))el.classList.add("synergy-partner");
      else el.classList.add("dimmed");
      // 保留整個角色庫，讓使用者看見共鳴與非共鳴角色
    }else if(hasFilter){
      if(filterMatch)el.classList.add("match-filter");else el.classList.add("dimmed");
      // 篩選時仍顯示全部卡片，未符合者淡化，方便比較
    }
    if(!searchMatch)show=false;
    el.style.display=show?"":"none";
    if(show)visible++;
  });
  if(activeCoreCard)title.innerHTML=`⭐ 正在檢視與【${escapeHtml(activeCoreCard.name)}（${activeCoreCard.app}）】有技能共鳴的夥伴`;
  else if(hasFilter)title.textContent="🔍 已篩選符合條件的成員";
  else title.textContent="HoloDream 成員配對庫";
  count.textContent=`顯示 ${visible} / ${cardDatabase.length} 張角色卡`;
  empty.style.display=visible?"none":"block";
}
function isSynergy(core,other){
  const cond=core.condType;
  if(!cond||cond==="無"||cond==="（無提供技能資料）")return false;
  if(cond==="同期")return core.gen===other.gen;
  if(cond==="1期生")return other.gen==="JP 1期生"||other.name==="白上吹雪";
  return cond===other.attr;
}
function escapeHtml(s){return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
document.querySelectorAll(".filter-btn").forEach(btn=>btn.addEventListener("click",()=>{
  const type=btn.dataset.type,value=btn.dataset.value;
  filters[type]=filters[type]===value?null:value;
  document.querySelectorAll(`.filter-btn[data-type="${type}"]`).forEach(b=>b.classList.toggle("active",b.dataset.value===filters[type]));
  activeCoreCard=null;render();
}));
document.getElementById("resetBtn").addEventListener("click",()=>{
  Object.keys(filters).forEach(k=>filters[k]=null);activeCoreCard=null;searchBox.value="";
  document.querySelectorAll(".filter-btn").forEach(b=>b.classList.remove("active"));render();
});
searchBox.addEventListener("input",()=>{activeCoreCard=null;render();});
render();
</script>
</body>
</html>
